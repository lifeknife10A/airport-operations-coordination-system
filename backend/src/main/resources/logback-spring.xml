<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Boot's own default pattern, with one addition: %X{correlationId} pulls in the id
    RequestLoggingFilter puts in the MDC for the lifetime of each request. Without this, the
    correlationId GlobalExceptionHandler puts in an error response has nothing to match against
    in the actual log lines, which defeats the point of having it.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %clr([%X{correlationId:-» no-request}]){yellow} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-default}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Business-event logging added to these services; everything else stays at INFO/WARN/ERROR. -->
    <logger name="com.saphire.aocs" level="INFO"/>
</configuration>

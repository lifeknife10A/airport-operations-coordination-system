# Copy to .env (already gitignored -- see .gitignore) and fill in real values for anything beyond
# local docker-compose use. These two are read by docker-compose.yml; application-prod.properties
# takes a larger, stricter set (DB_URL/DB_USERNAME/DB_PASSWORD/AOCS_JWT_SECRET/
# CORS_ALLOWED_ORIGINS) with no defaults at all -- see that file's own comments.

DB_PASSWORD=postgres
AOCS_JWT_SECRET=
